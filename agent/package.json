{
  "name": "yoru-agent",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "YORU - hyper-advanced self-hosted AI agent: multi-provider AI (OpenRouter/Ollama/OpenAI/Anthropic/Groq), computer control tools, Discord bot + selfbot, lookups scanner. Cross-platform (Linux/Windows).",
  "bin": {
    "yoru": "bin/yoru.js"
  },
  "scripts": {
    "postinstall": "node scripts/install.js",
    "setup": "node scripts/install.js",
    "yoru": "node src/index.js",
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "openclaw:setup": "node scripts/openclaw-setup.js",
    "openclaw:start": "openclaw gateway start",
    "openclaw:status": "openclaw gateway status"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "discord.js": "^14.16.3",
    "discord.js-selfbot-v13": "^3.5.1",
    "dotenv": "^16.4.5",
    "pdf-parse": "^1.1.1"
  }
}
