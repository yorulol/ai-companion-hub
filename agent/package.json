{
  "name": "yoru-agent",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "YORU - hyper-advanced self-hosted AI agent: multi-provider AI (OpenRouter/Ollama/OpenAI/Anthropic/Groq), computer control tools, Discord bot + selfbot, voice call recording + transcription, lookups scanner. Cross-platform (Linux/Windows).",
  "bin": {
    "yoru": "bin/yoru.js"
  },
  "scripts": {
    "postinstall": "node scripts/install.js",
    "setup": "node scripts/install.js",
    "doctor": "node scripts/install.js",
    "yoru": "node src/index.js",
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "openclaw:setup": "node scripts/openclaw-setup.js",
    "openclaw:start": "node -e \"import('./src/openclaw-runner.js').then(m => m.startOpenClaw({ force: true, autoInstall: true }))\"",
    "openclaw:status": "node scripts/openclaw-status.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@discordjs/voice": "^0.17.0",
    "better-sqlite3": "^12.2.0",
    "discord.js": "^14.16.3",
    "discord.js-selfbot-v13": "^3.5.1",
    "dotenv": "^16.4.5",
    "ffmpeg-static": "^5.2.0",
    "libsodium-wrappers": "^0.7.15",
    "opusscript": "^0.1.1",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.15.1",
    "prism-media": "^1.3.5",
    "tweetnacl": "^1.0.3"
  },
  "optionalDependencies": {
    "@discordjs/opus": "^0.9.0",
    "@huggingface/transformers": "^3.0.2"
  }
}
