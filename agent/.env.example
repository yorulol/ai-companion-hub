# ---- Owner ----
# Your Discord user ID. This is the only ID that can open the owner panel.
OWNER_DISCORD_ID=

# ---- OpenRouter (primary AI) ----
OPENROUTER_API_KEY=
# Optional, shown on OpenRouter rankings
OPENROUTER_SITE_URL=http://localhost:8787
OPENROUTER_APP_NAME=NOVA Agent

# ---- Ollama (backup AI, runs on your machine) ----
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1
OLLAMA_CODE_MODEL=qwen2.5-coder

# ---- Discord bot ----
DISCORD_BOT_TOKEN=
DEFAULT_PREFIX=!
BOT_AUTOSTART=true

# ---- Personal account responder (against Discord ToS - use an alt only) ----
DISCORD_USER_TOKEN=
SELFBOT_AUTOSTART=false

# ---- Local service ----
PORT=8787
# Comma separated origins allowed to talk to this service (the web panels).
ALLOWED_ORIGINS=*
