# ============================================================
#  YORU AGENT  ·  environment
# ============================================================

# ---- Hermes agent (Nous Research Hermes-3, hardware-aware) ----
# When enabled, chat routes through a Hermes-3 model served by your local
# Ollama daemon. Yoru detects your CPU/GPU/RAM and picks the tier that fits:
#   • hermes3:3b   → small machines / no GPU
#   • hermes3:8b   → 6+ GB VRAM or 12+ GB RAM
#   • hermes3:70b  → 24+ GB VRAM or 48+ GB RAM
# Leave HERMES_MODEL blank for auto-select, or pin a specific ollama tag.
HERMES_ENABLED=true
HERMES_MODEL=

# ---- Ollama (local backup / runtime for Hermes and UF) ----
OLLAMA_ENABLED=true
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b-instruct-q4_K_M
OLLAMA_REASONING_MODEL=qwen2.5:3b-instruct-q4_K_M
OLLAMA_CODE_MODEL=qwen2.5-coder:3b-instruct-q4_K_M

# ---- UF custom variant (built from agent/UF/Modelfile during npm install) ----
OLLAMA_UF_ENABLED=false
OLLAMA_UF_BASE_MODEL=qwen2.5:3b-instruct-q4_K_M
OLLAMA_UF_MODEL=qwen-yoru
OLLAMA_UF_MODELFILE=agent/UF/Modelfile

# ---- Heretic abliterated Qwen (optional) ----
OLLAMA_HERETIC_ENABLED=false
OLLAMA_HERETIC_MODEL=hf.co/richardyoung/Qwen2.5-3B-Instruct-heretic:Q4_K_M

# Which provider to try FIRST (hermes | ollama)
PREFERRED_PROVIDER=hermes

# ============================================================
#  DISCORD
# ============================================================
DISCORD_BOT_TOKEN=
DEFAULT_PREFIX=!
OWNER_PREFIX=!
BOT_AUTOSTART=true

# Personal account responder. AGAINST DISCORD ToS - use an alt
# account you don't mind losing.
DISCORD_USER_TOKEN=
SELFBOT_AUTOSTART=false

# ============================================================
#  COMPUTER CONTROL  ·  agent gets access to your machine
# ============================================================
COMPUTER_CONTROL_ENABLED=true
COMPUTER_CONTROL_ROOT=
COMPUTER_CONTROL_UNRESTRICTED=false
LOCKDOWN_ENABLED=true

CLAMSCAN_PATH=
WINDEFENDER_PATH=

# ---- Ollama tuning (Hermes and plain Ollama share these) ----
# GPU-first: 999 = push every layer to VRAM. If the model + context exceed
# your VRAM (e.g. 6 GB), Ollama automatically spills the overflow to system
# RAM/CPU — no config needed, it never crashes on overflow.
OLLAMA_NUM_CTX=1536
OLLAMA_NUM_PREDICT=140
OLLAMA_NUM_BATCH=384
OLLAMA_NUM_GPU=999
OLLAMA_NUM_THREAD=0
OLLAMA_BALANCED_GPU_LAYERS=999
OLLAMA_HISTORY_MESSAGES=8
OLLAMA_LATENCY_BUDGET_MS=9000
OLLAMA_MIN_PREDICT=64

# ============================================================
#  AUTO-UPDATER
# ============================================================
AUTO_UPDATE_ENABLED=true
AUTO_UPDATE_GIT=true
AUTO_UPDATE_WATCH=true
AUTO_UPDATE_INTERVAL=60
AUTO_UPDATE_DEBOUNCE=3
DEPS_AUTO_UPDATE=true

# ── Call recording + transcription ─────────────────────────────────────────
CALL_RECORDING_ENABLED=true
STT_ENABLED=true
STT_LANGUAGE=en
STT_WHISPER_BIN=
STT_WHISPER_MODEL=
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=whisper-1
FFMPEG_PATH=
STT_LOCAL_ENABLED=true
STT_LOCAL_MODEL=Xenova/whisper-base.en

# ============================================================
#  LOCAL MODELS
# ============================================================
LOCALMODEL_ENABLED=false
LOCALMODEL_DIR=agent/models
LOCALMODEL_ACTIVE=
LOCALMODEL_RUNTIME=auto
LOCALMODEL_LATENCY_BUDGET_MS=9000
LOCALMODEL_MIN_PREDICT=64
