# ============================================================
#  YORU AGENT  ·  environment configuration
# ============================================================
# Fill in what you use. Anything left blank is simply disabled.
# Copy this file to .env and add your real keys.
# ------------------------------------------------------------

# ---- Owner ----
# Your Discord user ID. Only these IDs can open the owner panel,
# see the "owner" help category, and trigger destructive computer actions.
# Comma-separate to allow several owners (either variable works).
OWNER_DISCORD_ID=
OWNER_DISCORD_IDS=


# ---- Local HTTP service ----
PORT=8787
# Comma-separated origins allowed to call this service.
# Use * during setup, tighten later.
ALLOWED_ORIGINS=*

# ---- Local panels ----
PANELS_ENABLED=true
# The merged YORU panel — Chat + Owner controls + WorkSpace in one page.
CHAT_PANEL_PORT=8788
# Dedicated WorkSpace panel (multi-agent mode). Also reachable from a tab
# inside the merged panel above. OWNER_PANEL_PORT still works as an alias.
WORKSPACE_PANEL_PORT=8789

# ---- Team share ----
# Opt-in second surface exposing ONLY the terminal chat and lookup tab to
# teammates on your LAN (or via a port forward / tunnel). Bind to 0.0.0.0
# to reach it off-host. The token is auto-generated by `npm install`.
TEAM_SHARE_ENABLED=false
TEAM_SHARE_PORT=8790
TEAM_SHARE_BIND=0.0.0.0
TEAM_SHARE_TOKEN=

# ============================================================
#  AI PROVIDERS  ·  turn on any combination
# ============================================================
# Fallback order (top to bottom) when a call fails:
#   1. Preferred provider (set below)
#   2. OpenRouter free models (rotates through every free model)
#   3. Groq / OpenAI / Anthropic (if enabled)
#   4. Ollama (local, always the last-resort backup)
# Set an "_ENABLED" flag to "false" to skip that provider even
# when a key is present.

# ---- OpenRouter (primary, uses every free model) ----
OPENROUTER_ENABLED=true
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=http://localhost:8787
OPENROUTER_APP_NAME=YORU Agent

# ---- Ollama (local backup) ----
# These values are AUTO-TUNED for your machine by `npm install` / `npm run setup`
# (it detects CPU, RAM and GPU VRAM, then picks the fastest models that fit).
# Shown below: the profile for i7 + RTX 1660 Ti (6 GB VRAM) + 16 GB RAM.
OLLAMA_ENABLED=true
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b-instruct-q4_K_M
OLLAMA_REASONING_MODEL=qwen2.5:7b-instruct-q4_K_M
OLLAMA_CODE_MODEL=qwen2.5-coder:7b-instruct-q4_K_M
OLLAMA_NUM_CTX=1536
OLLAMA_NUM_PREDICT=140
OLLAMA_HISTORY_MESSAGES=3
OLLAMA_NUM_BATCH=512
OLLAMA_NUM_GPU=999
# 0 = let Ollama pick thread count
OLLAMA_NUM_THREAD=0
# GPU layers used for long prompts so overflow can use RAM/CPU without dropping GPU acceleration.
OLLAMA_BALANCED_GPU_LAYERS=24
# Target wall-clock reply time in ms. YORU measures the model's real tokens/sec
# and caps each generation so replies land inside this window (1-10s by default).
OLLAMA_LATENCY_BUDGET_MS=9000
# Never generate fewer than this many tokens, even on a slow machine.
OLLAMA_MIN_PREDICT=64

# ---- UF custom variant (optional) ----
# `npm install` / `npm run setup` pulls qwen2.5:1.5b, writes agent/UF/Modelfile,
# and builds a custom model from it (`ollama create qwen-yoru -f agent/UF/Modelfile`).
# true  = chat uses the UF variant. false = chat uses the plain OLLAMA_MODEL.
# Only affects chat; reasoning and coding models are untouched.
OLLAMA_UF_ENABLED=false
OLLAMA_UF_BASE_MODEL=qwen2.5:3b-instruct-q4_K_M
OLLAMA_UF_MODEL=qwen-yoru
OLLAMA_UF_MODELFILE=agent/UF/Modelfile

# ---- Heretic (abliterated Qwen2.5-3B-Instruct via Hugging Face) ----
# Auto-pulled by `npm install` when enabled. Same 3B size and speed profile as
# the default chat model, with the refusal layer removed.
# true = chat uses the heretic model in place of OLLAMA_MODEL (UF still wins if
# both are on). Reasoning and coding models are untouched.
OLLAMA_HERETIC_ENABLED=false
OLLAMA_HERETIC_MODEL=hf.co/richardyoung/Qwen2.5-3B-Instruct-heretic:Q4_K_M


# ---- OpenAI ----
OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- Anthropic (Claude) ----
ANTHROPIC_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# ---- Groq (fast free tier) ----
GROQ_ENABLED=false
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ---- OpenClaw (self-hosted gateway, https://github.com/openclaw/openclaw) ----
# One-time install:   npm run openclaw:setup
# Manual start:       npm run openclaw:start
# Yoru owns one foreground gateway process; it does not rely on a stale OS service.
OPENCLAW_ENABLED=true
OPENCLAW_AUTOSTART=true
OPENCLAW_API_KEY=
# Written automatically alongside OPENCLAW_API_KEY for OpenClaw's CLI.
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_BASE_URL=http://127.0.0.1:18789/v1
OPENCLAW_MODEL=openclaw/default

# ---- Mail Forwarding (mail.thc.org / reads.phrack.org) ----
# Free anonymous email forwarding. Get an API key: https://reads.phrack.org/docs/#8-request-an-api-key
EMAIL_FORWARD_ENABLED=false
EMAIL_FORWARD_API_KEY=
# Base URL. Default: https://mail.thc.org/api — docs: https://reads.phrack.org/docs/
EMAIL_FORWARD_API_URL=https://mail.thc.org/api

# Which provider to try FIRST (openrouter | ollama | openai | anthropic | groq | openclaw)
PREFERRED_PROVIDER=openrouter
# Maximum active free OpenRouter models tried before falling back locally.
# YORU keeps 15 active models, immediately replaces failures from reserve, and
# rebuilds the pool from OpenRouter's live catalogue every five minutes.
OPENROUTER_MAX_ATTEMPTS=10

# ============================================================
#  DISCORD
# ============================================================
DISCORD_BOT_TOKEN=
DEFAULT_PREFIX=!
# Private command prefix used by OWNER_DISCORD_ID on both bot and alt account.
OWNER_PREFIX=!
BOT_AUTOSTART=true

# Personal account responder. AGAINST DISCORD ToS - use an alt
# account you don't mind losing.
DISCORD_USER_TOKEN=
SELFBOT_AUTOSTART=false

# ============================================================
#  COMPUTER CONTROL  ·  agent gets access to your machine
# ============================================================
# Master switch. When false, all filesystem / system commands
# are blocked no matter who asks.
COMPUTER_CONTROL_ENABLED=true

# Sandbox root. File create/move/delete is restricted to paths
# inside this directory unless COMPUTER_CONTROL_UNRESTRICTED=true.
# Defaults to your home directory.
COMPUTER_CONTROL_ROOT=

# DANGEROUS: allow file operations anywhere on the machine.
COMPUTER_CONTROL_UNRESTRICTED=false

# Allow emergency lockdown. It pauses computer-control actions until the owner
# releases it with the private key; files are never encrypted or changed.
LOCKDOWN_ENABLED=true

# Malware scan uses ClamAV (`clamscan`) on Linux and Windows
# Defender (`MpCmdRun`) on Windows. Set the path if it isn't on
# your PATH.
CLAMSCAN_PATH=
WINDEFENDER_PATH=

# ── Call recording + transcription ─────────────────────────────────────────
# Finished calls are saved to agent/calls/ as "<Server> (<ID>) - <date time>"
# with a .pdf transcript, a .txt transcript and a .mp3 recording of the call.
CALL_RECORDING_ENABLED=true

# Speech-to-text. Leave both blocks empty and calls still get audio + PDF,
# just without spoken text.
STT_ENABLED=true
STT_LANGUAGE=en
# Option A — fully local whisper.cpp (no keys, no internet):
STT_WHISPER_BIN=
STT_WHISPER_MODEL=
# Option B — any OpenAI-compatible /audio/transcriptions server:
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=whisper-1
# Bundled ffmpeg is installed automatically; leave blank to use PATH.
FFMPEG_PATH=
# Zero-config local whisper (no keys, no server). Set false to disable.
STT_LOCAL_ENABLED=true
STT_LOCAL_MODEL=Xenova/whisper-base.en

# ============================================================
#  LOCAL MODELS  ·  custom models you built yourself
# ============================================================
# Use the Model Builder (panel Models tab, or `/build <source>` in the terminal,
# or `!build <source>` from the alt account) to convert a HuggingFace-style
# folder or a .gguf file into a runnable model. Built models land in
# agent/models/<name>/ with a Modelfile + manifest and are auto-registered with
# Ollama. Flip LOCALMODEL_ENABLED=true to make chat prefer your built model.
LOCALMODEL_ENABLED=false
LOCALMODEL_DIR=agent/models
# Blank = auto-pick the smallest built model (fastest replies).
LOCALMODEL_ACTIVE=
LOCALMODEL_RUNTIME=auto
LOCALMODEL_LATENCY_BUDGET_MS=9000
LOCALMODEL_MIN_PREDICT=64
# Optional HuggingFace access token — only needed for gated/private repos when
# the builder downloads a HuggingFace repo ID (e.g. `TheBloke/Llama-2-7B-GGUF`).
HF_TOKEN=
# Optional base model for LoRA/PEFT adapters. If the adapter source doesn't
# declare a base, the builder uses this (any Ollama-registered model name).
LOCALMODEL_LORA_BASE=


